# -----------------------------------------------------------------------------
# Backend environment (copy → `.env`; run Spring from `backend/` so this file loads)
# -----------------------------------------------------------------------------
# Sensitive values use _INSERT_* or _REPLACE_* — replace those before prod use.

SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# H2 (dev defaults)
SPRING_DATASOURCE_URL="jdbc:h2:file:./splitwise-db;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=TRUE;AUTO_RECONNECT=TRUE"
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=_INSERT_MAIL_USERNAME
MAIL_PASSWORD=_INSERT_MAIL_PASSWORD

# Must be ≥ 256-bit secret for HS256 (replace with openssl rand -base64 48, etc.).
JWT_SECRET=_REPLACE_JWT_SECRET_USE_OPENSSL_rand_base64_48_OR_RANDOM_256BIT_MIN_CHARS_OK________
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# AI: Gemini — AI_PROVIDER=gemini, AI_MODEL=gemini-2.0-flash, GEMINI_BASE_URL=...
# AI: Groq (OpenAI-compatible) — use groq provider + Groq base + a Groq model id.
AI_PROVIDER=groq
AI_ENABLED=true
AI_API_KEY=_INSERT_GROQ_API_KEY
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT=30
AI_MAX_TOKENS=1024
# If PKIX / SSLHandshakeException: corporate SSL inspection — set true temporarily or import proxy CA into JVM.
AI_SSL_INSECURE=false
